# Copy to terraform.tfvars (gitignored). `make gcp-plan ENV=staging` uses it.
# Staging: pre-release validation and stakeholder review (architecture.md,
# Environments); GCP us-central1 (D-032).

project_id  = "sabi-hq"
environment = "staging"
region      = "us-central1"

# Cloud SQL Enterprise edition, shared-core tier: HDD storage is only available
# on the general purpose shared/dedicated core machine series, and the route
# requires HDD.
db_tier              = "db-f1-micro"
db_allocated_storage = 10
db_disk_type         = "PD_HDD"

# Private services scale to zero while stopped; the `up` workflow raises the API
# minimum when it deploys (D-033).
api_min_instances      = 0
api_max_instances      = 4
ai_max_instances       = 3
payments_max_instances = 3
console_max_instances  = 2

# Passkey association (FEAT-001). The gateway serves these from
# /.well-known/ so each platform can verify the app belongs to the domain.
# Add every signing certificate: a build signed with an unlisted key cannot
# complete a ceremony. The value below is the local debug keystore's SHA-256
# (`keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey`);
# replace or extend it for upload and Play App Signing certificates.
android_package_name      = "ng.sabi.sabi_mobile"
android_cert_fingerprints = ["51:60:03:F2:CC:9B:70:47:52:A5:EE:4E:DF:A7:0C:5E:29:F9:77:04:41:CE:5F:B9:6A:23:8B:1D:35:12:5E:99"]

# iOS: <TeamID>.<bundle id>. Left empty until the Apple Developer team id is
# known; the AASA file then returns 404 rather than advertising an unverified app.
apple_app_id = ""
