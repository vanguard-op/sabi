# Mobile local configuration template. Copy to `.env` and adjust for your machine:
#
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
#
# Flutter reads both .env and .json forms with --dart-define-from-file, so the
# file is key=value, not JSON. Every key here maps to a String/bool
# `fromEnvironment` read in `lib/core/api_config.dart`; a key that no code reads
# does nothing.
#
# No secrets belong in this file (NFR-024): the base URL is public, and the
# session is an HttpOnly cookie the client never reads or logs.

# Base URL of the API gateway, including the /v1 prefix and no trailing slash.
# Android emulator -> host machine: http://10.0.2.2:8000/v1
# iOS Simulator / desktop:          http://localhost:8000/v1
API_BASE_URL=http://10.0.2.2:8000/v1

# true resolves repositories to the live HTTP client; false keeps the in-memory
# mocks so no socket is opened.
USE_LIVE_REPOSITORIES=true
