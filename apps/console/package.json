{
  "name": "@sabi/operations-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sabi staff Operations Console — Phase 1 provider review, schema review, health and quarantine, and privileged-action audit.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
