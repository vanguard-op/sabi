# Sabi environment configuration - single source of truth for local development.
#
#   cp .env.example .env        # local dev; .env is gitignored, never commit it
#
# In staging and production no real value lives here or in the repo: every value
# is injected from the managed secret store (NFR-024). The AWS Terraform baseline
# creates the container under <project>/<environment>/app; the GCP stack
# (infra/terraform-gcp) creates one container per key under <prefix>-<key>. Set
# the values out-of-band. CI runs with placeholders only.

# --- Runtime ---
ENVIRONMENT=development                 # development | staging | production
LOG_LEVEL=debug
API_HOST=0.0.0.0
API_PORT=8000
AI_HOST=0.0.0.0
AI_PORT=8001

# --- Datastores ---
# Values below match docker-compose.yml, which is the dev source of truth.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sabi
POSTGRES_USER=sabi
POSTGRES_PASSWORD=local-dev-only-change-me

# Isolated payment store: own database and transaction boundary (architecture.md).
PAYMENTS_DB=sabi_payments

# Connection strings consumed by the services. psycopg is the SQLAlchemy driver.
DATABASE_URL=postgresql+psycopg://sabi:local-dev-only-change-me@localhost:5432/sabi
PAYMENTS_DATABASE_URL=postgresql+psycopg://sabi:local-dev-only-change-me@localhost:5432/sabi_payments
CACHE_URL=redis://localhost:6379/0

# Session and rate-limit store selection: auto | memory | redis.
# "auto" uses Redis when a cache is configured, memory otherwise. A hosted
# (Cloud Run) or production environment may not leave this to "auto": staging
# with no cache must state "memory" explicitly (D-032), and production must
# resolve to Redis or boot fails. Set the matching value per environment.
SESSION_STORE_BACKEND=auto
RATE_LIMIT_STORE_BACKEND=auto

# --- Identity, auth, and sessions (FEAT-001, NFR-020..NFR-027) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Sabi
WEBAUTHN_ORIGIN=http://localhost:8000
# Android passkey origins are derived, not configured (FEAT-001, D-038). The
# settings parser reads ANDROID_CERT_FINGERPRINTS as a JSON array of SHA-256
# signing-certificate fingerprints, the same certificates
# /.well-known/assetlinks.json names, and derives one
# "android:apk-key-hash:<base64url(sha256(cert))>" origin per fingerprint. It
# composes those with WEBAUTHN_ORIGIN and https://<WEBAUTHN_RP_ID> into the
# accepted-origin list (C-002/C-004), so the association file and the WebAuthn
# allowlist cannot drift (NFR-024). Local development may leave it empty; a
# managed deployment is given the list as launch environment by Terraform
# (infra/terraform-gcp/cloud_run.tf), never from this file.
ANDROID_CERT_FINGERPRINTS=[]
SESSION_COOKIE_NAME=sabi_session
SESSION_SECRET=local-dev-only-change-me
RECOVERY_CODE_PEPPER=local-dev-only-change-me

# --- Model provider (D-054; the stable pinned ID recorded in model-quality.md) ---
# Leave blank in the template: the AI owner pins the single stable build and records
# it in model-quality.md. Every capability runs on it; there is no primary/preview
# path. Never commit a real API key.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL_ID=gemini-3.1-flash-lite
MODEL_TIMEOUT_SECONDS=20

# --- Cloud / IaC ---
# Region is Africa (Cape Town), the closest managed region to the Nigeria-primary
# intent in architecture.md; NDPA transfer position is assessed at Foundation (D-005).
AWS_REGION=af-south-1

# --- GCP staging (D-032/D-033) ---
# The hosted staging environment lives in GCP us-central1 and serves on
# subdomains of sabi.ahmadkhidir.com. Infrastructure is infra/terraform-gcp/**,
# driven by the manual gcp-up / gcp-stop / gcp-destroy workflows.
#
# These three are GitHub repository variables (and Terraform variable defaults),
# not values in a service's .env. The Terraform stack defaults them in
# variables.tf, so they are stated here only for the CI workflows to read.
GCP_PROJECT_ID=sabi-hq
GCP_REGION=us-central1
GCP_DOMAIN_ROOT=ahmadkhidir.com

# Staging relying-party configuration (FEAT-001). The staging host is the API
# subdomain, so a passkey ceremony is bound to the deployed origin rather than
# localhost. Values are placeholders here; the real ones are set as launch
# environment by Terraform (infra/terraform-gcp/cloud_run.tf), never committed.
WEBAUTHN_RP_ID=api.sabi.ahmadkhidir.com
WEBAUTHN_ORIGIN=https://api.sabi.ahmadkhidir.com

# Staging Android origins follow the same derivation: Terraform passes
# ANDROID_CERT_FINGERPRINTS (infra/terraform-gcp/cloud_run.tf) from the staging
# tfvars, and the backend derives each "android:apk-key-hash:<base64url>" origin
# from it (D-038). There is no separate native-origins secret to set.

# CI/CD authenticates to GCP through Workload Identity Federation, never a
# committed service-account key (NFR-024). These are repository variables on the
# GitHub environment, not .env values:
#   GCP_WIF_PROVIDER      projects/<num>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
#   GCP_SERVICE_ACCOUNT   the deployer service account email
# The model provider key (GEMINI_API_KEY) is a GitHub secret written to Secret
# Manager by the gcp-up workflow; it is never stored in the repo.
