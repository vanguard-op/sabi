        <Node name="Mark" x="720" y="1280" scaleX="0.78125" scaleY="0.78125" id="0:41">
            <Shape name="Body" x="0" y="-73.72" id="0:45">
                <Rectangle width="737.28" height="479.23" cornerRadiusTL="147.456"
