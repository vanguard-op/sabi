<Rive version="1" kind="fragment">
    <!--
      Sabi UI icon set. Custom 24px outlined set drawn to the mark's rounded
      geometry: 24px grid, 2px stroke, round caps and joins, 2px corner radius.
      Single flat colour (grey-600 #5B5F54 = text-secondary) so the client can
      tint the whole glyph per state with a colour filter. No fills except the
      small dots, which read at the 2px weight.
      Artboards are named Icon<Name>; load by name from assets/sabi.riv (D-016).
    -->

    <!-- 0. home -->
    <Artboard width="24" height="24" name="IconHome" styleId="0:300" x="0" y="3600" id="0:301">
        <LayoutComponentStyle name="IconHome Style" id="0:300"/>
        <Shape name="House">
            <PointsPath isClosed="true" isClockwise="true" name="Path">
                <StraightVertex x="12" y="3.5" radius="1.6"/>
                <StraightVertex x="20.5" y="10.5" radius="1.6"/>
                <StraightVertex x="20.5" y="20.5" radius="1.6"/>
                <StraightVertex x="3.5" y="20.5" radius="1.6"/>
                <StraightVertex x="3.5" y="10.5" radius="1.6"/>
            </PointsPath>
            <Stroke thickness="2" cap="round" join="round" name="Outline">
                <SolidColor colorValue="FF5B5F54" name="Color"/>
            </Stroke>
        </Shape>
        <Shape name="Door" x="12" y="17.5">
            <Rectangle width="5" height="6" linkCornerRadius="false"
                       cornerRadiusTL="1.8" cornerRadiusTR="1.8"
                       cornerRadiusBL="0" cornerRadiusBR="0"
                       originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="2" cap="round" join="round" name="Outline">
                <SolidColor colorValue="FF5B5F54" name="Color"/>
            </Stroke>
        </Shape>
    </Artboard>

    <!-- 1. search -->
    <Artboard width="24" height="24" name="IconSearch" styleId="0:302" x="300" y="3600" id="0:303">
        <LayoutComponentStyle name="IconSearch Style" id="0:302"/>
        <Shape name="Lens" x="10.5" y="10.5">
            <Ellipse width="13" height="13" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="2" cap="round" join="round" name="Outline">
                <SolidColor colorValue="FF5B5F54" name="Color"/>
            </Stroke>
        </Shape>
        <Shape name="Handle">
            <PointsPath isClosed="false" name="Path">
                <StraightVertex x="15.5" y="15.5"/>
                <StraightVertex x="20" y="20"/>
            </PointsPath>
            <Stroke thickness="2" cap="round" join="round" name="Outline">
                <SolidColor colorValue="FF5B5F54" name="Color"/>
            </Stroke>
        </Shape>
    </Artboard>

    <!-- 2. receipts -->
    <Artboard width="24" height="24" name="IconReceipts" styleId="0:304" x="600" y="3600" id="0:305">
        <LayoutComponentStyle name="IconReceipts Style" id="0:304"/>
        <Shape name="Sheet">
            <PointsPath isClosed="true" isClockwise="true" name="Path">
                <StraightVertex x="4.5" y="3.5" radius="1.6"/>
                <StraightVertex x="19.5" y="3.5" radius="1.6"/>
                <StraightVertex x="19.5" y="20"/>
                <StraightVertex x="16.5" y="17.5"/>
                <StraightVertex x="13.5" y="20"/>
                <StraightVertex x="10.5" y="17.5"/>
                <StraightVertex x="7.5" y="20"/>
                <StraightVertex x="4.5" y="20"/>
            </PointsPath>
            <Stroke thickness="2" cap="round" join="round" name="Outline">
                <SolidColor colorValue="FF5B5F54" name="Color"/>
            </Stroke>
        </Shape>
        <Shape name="Line1">
            <PointsPath isClosed="false" name="Path">
                <StraightVertex x="7.5" y="8.5"/>
                <StraightVertex x="16.5" y="8.5"/>
            </PointsPath>
            <Stroke thickness="2" cap="round" join="round" name="Outline">
                <SolidColor colorValue="FF5B5F54" name="Color"/>
            </Stroke>
        </Shape>
        <Shape name="Line2">
            <PointsPath isClosed="false" name="Path">
                <StraightVertex x="7.5" y="12.5"/>
                <StraightVertex x="16.5" y="12.5"/>
            </PointsPath>
            <Stroke thickness="2" cap="round" join="round" name="Outline">
                <SolidColor colorValue="FF5B5F54" name="Color"/>
            </Stroke>
        </Shape>
    </Artboard>

    <!-- 3. account -->
    <Artboard width="24" height="24" name="IconAccount" styleId="0:306" x="900" y="3600" id="0:307">
        <LayoutComponentStyle name="IconAccount Style" id="0:306"/>
        <Shape name="Head" x="12" y="7.5">
            <Ellipse width="8" height="8" originX="0.5" originY="0.5" name="Path"/>
